@PACKAGE_INIT@

# The targets of EvoAI name JsonBox::JsonBox when EvoAI was built against the CMake package of JsonBox:
# it has to be found before they are included (CMAKE_PREFIX_PATH, or JsonBox_DIR).
include(CMakeFindDependencyMacro)
@EvoAI_PACKAGE_DEPENDENCIES@

# An install holds the targets of the build it came from, shared or static. A prefix with both gets the
# shared library unless EvoAI_BUILD_STATIC is set before find_package(EvoAI).
if(EvoAI_BUILD_STATIC OR NOT EXISTS "${CMAKE_CURRENT_LIST_DIR}/EvoAISharedTargets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/EvoAIStaticTargets.cmake")
else()
    include("${CMAKE_CURRENT_LIST_DIR}/EvoAISharedTargets.cmake")
endif()
check_required_components(EvoAI)
