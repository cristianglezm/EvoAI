{
    "version": 7,
    "cmakeMinimumRequired": {
      "major": 3,
      "minor": 27,
      "patch": 0
    },
    "configurePresets": [
      {
        "name": "mingw",
        "displayName": "MinGW Config",
        "description": "Build using MinGW",
        "generator": "MinGW Makefiles",
        "binaryDir": "${sourceDir}/build/mingw",
        "cacheVariables": {
            "EvoAI_BUILD_DOCS": "OFF",
            "EvoAI_BUILD_TESTS": "OFF",
            "EvoAI_BUILD_EXAMPLES": "OFF",
            "EvoAI_BUILD_TOOLS": "OFF",
            "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
            "SFML_ROOT": "/c/libs/SFML",
            "JsonBox_ROOT": "/c/libs/JsonBox",
            "GTest_ROOT": "/c/libs/googletest"
        }
      },
      {
        "name": "mingw-all",
        "displayName": "mingw all",
        "description": "dev build using MinGW",
        "inherits": "mingw",
        "binaryDir": "${sourceDir}/build/mingw-all",
        "cacheVariables": {
          "EvoAI_BUILD_DOCS": "ON",
          "EvoAI_BUILD_TESTS": "ON",
          "EvoAI_BUILD_EXAMPLES": "ON",
          "EvoAI_BUILD_TOOLS": "ON",
          "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
        }
      },
      {
        "name": "mingw-ci",
        "displayName": "mingw ci",
        "description": "fast build for running tests only (no docs/examples/tools)",
        "inherits": "mingw",
        "binaryDir": "${sourceDir}/build/mingw-ci",
        "cacheVariables": {
            "EvoAI_BUILD_TESTS": "ON"
        }
      },
      {
        "name": "mingw-all-debug",
        "displayName": "mingw all (Debug)",
        "description": "dev build using MinGW, for testing a real Debug build",
        "inherits": "mingw-all",
        "binaryDir": "${sourceDir}/build/mingw-all-debug",
        "cacheVariables": {
          "CMAKE_BUILD_TYPE": "Debug"
        }
      },
      {
        "name": "mingw-docs",
        "displayName": "mingw docs",
        "description": "build docs",
        "generator": "MinGW Makefiles",
        "inherits": "mingw",
        "binaryDir": "${sourceDir}/build/docs",
        "cacheVariables": {
            "EvoAI_BUILD_DOCS": "ON"
        }
      },
      {
        "name": "linux-fuzz",
        "displayName": "linux fuzz",
        "description": "Clang + libFuzzer harnesses (see test/fuzz/README.md). Not for Windows: libFuzzer/ASan aren't available with MinGW/MSVC here.",
        "generator": "Unix Makefiles",
        "binaryDir": "${sourceDir}/build/fuzz",
        "condition": {
          "type": "notEquals",
          "lhs": "${hostSystemName}",
          "rhs": "Windows"
        },
        "cacheVariables": {
            "CMAKE_CXX_COMPILER": "clang++",
            "CMAKE_BUILD_TYPE": "Release",
            "EvoAI_BUILD_FUZZERS": "ON",
            "JsonBox_ROOT": "${sourceDir}/JsonBox/build/install"
        }
      }
    ],
    "buildPresets": [
      {
        "name": "mingw-release",
        "configurePreset": "mingw-all",
        "configuration": "Release",
        "jobs": 4,
        "targets": ["all"]
      },
      {
        "name": "mingw-docs",
        "configurePreset": "mingw-docs",
        "displayName": "Build mingw-docs",
        "configuration": "Release",
        "jobs": 4,
        "targets": [ "docs" ]
      },
      {
        "name": "mingw-ci",
        "configurePreset": "mingw-ci",
        "displayName": "Build mingw-ci",
        "jobs": 4,
        "targets": ["all"]
      },
      {
        "name": "linux-fuzz",
        "configurePreset": "linux-fuzz",
        "displayName": "Build linux-fuzz",
        "jobs": 4,
        "targets": ["all"]
      }
    ],
    "testPresets": [
      {
        "name": "test-base",
        "hidden": true,
        "configurePreset": "mingw-all",
        "output": {
          "outputOnFailure": true
        },
        "execution": {
          "noTestsAction": "error",
          "stopOnFailure": true
        }
      },
      {
        "name": "mingw-ci-debug",
        "configuration": "Debug",
        "configurePreset": "mingw-all-debug",
        "inherits": "test-base"
      },
      {
        "name": "mingw-ci-release",
        "configuration": "Release",
        "inherits": "test-base"
      },
      {
        "name": "mingw-ci",
        "displayName": "Test mingw-ci",
        "configurePreset": "mingw-ci",
        "inherits": "test-base"
      }
    ],
    "packagePresets": [
      {
        "name": "mingw-zip",
        "configurePreset": "mingw-all",
        "generators": [
          "ZIP"
        ]
      }
    ],
    "workflowPresets": [
      {
        "name": "mingw-release",
        "steps": [
          {
            "type": "configure",
            "name": "mingw-all"
          },
          {
            "type": "build",
            "name": "mingw-release"
          },
          {
            "type": "test",
            "name": "mingw-ci-release"
          },
          {
            "type": "package",
            "name": "mingw-zip"
          }
        ]
      },
      {
        "name": "mingw-ci",
        "displayName": "Fast tests-only loop (no docs/examples/tools)",
        "steps": [
          {
            "type": "configure",
            "name": "mingw-ci"
          },
          {
            "type": "build",
            "name": "mingw-ci"
          },
          {
            "type": "test",
            "name": "mingw-ci"
          }
        ]
      },
      {
        "name": "linux-fuzz",
        "displayName": "Build the libFuzzer harnesses (see test/fuzz/README.md to run them)",
        "steps": [
          {
            "type": "configure",
            "name": "linux-fuzz"
          },
          {
            "type": "build",
            "name": "linux-fuzz"
          }
        ]
      }
    ]
  }
